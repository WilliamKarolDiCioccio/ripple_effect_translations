{
  "@@locale": "en",
  "languageName": "English",
  "@languageName": {
    "description": "Not a translation of the word \"English\". Write the name of the language this file is in, in that language: Italiano in the Italian file, Deutsch in the German one, 日本語 in the Japanese one. The language picker lists every language under its own name, so a reader can find theirs whatever the app is currently showing."
  },
  "settingsTitle": "Settings",
  "@settingsTitle": {
    "description": "Title of the app's own settings dialog, opened from the gear in the app bar."
  },
  "settingsClose": "Close",
  "@settingsClose": {
    "description": "The button that closes the settings dialog. Every choice in it has already taken effect, so this is not 'Save' or 'Apply'."
  },
  "settingsLanguageLabel": "Language",
  "@settingsLanguageLabel": {
    "description": "Section heading over the language picker in the settings dialog. Write it in normal case: the dialog shows every section heading in capitals by itself."
  },
  "settingsLanguageSystem": "System ({language})",
  "@settingsLanguageSystem": {
    "description": "The first entry in the language picker: follow the operating system's language. {language} is the name of the language that currently resolves to, in that language (for example 'English').",
    "placeholders": {
      "language": {
        "type": "String",
        "example": "English"
      }
    }
  },
  "settingsLanguageExplanation": "The language of the app itself. A project's own languages are set in its settings.",
  "@settingsLanguageExplanation": {
    "description": "The line under the language picker. Makes clear this does not change the language a story is written in."
  },
  "settingsPlayingLabel": "Playing",
  "@settingsPlayingLabel": {
    "description": "Section heading over the loop-ceiling control in the settings dialog. Write it in normal case: the dialog shows every section heading in capitals by itself."
  },
  "settingsLoopLimitNone": "None",
  "@settingsLoopLimitNone": {
    "description": "The last segment of the loop-ceiling control: no limit on how many times a loop node may repeat. The other segments are plain numbers (128, 512 …). Very little room: five segments share one row."
  },
  "settingsLoopLimitExplanation": "How many times one loop node may go round before a campaign stops with an error, and offers you the node. Counted per loop and per board: jumping away and coming back starts again. Far more than a story needs — the ceiling is there to catch a loop with no way out.",
  "@settingsLoopLimitExplanation": {
    "description": "The line under the loop-ceiling control when a number is chosen. A 'loop node' is a node on the story canvas that repeats, such as While; a 'campaign' is a story being played."
  },
  "settingsLoopLimitNoneExplanation": "A loop node may go round for ever. A While with nothing breaking out of it will not stop the campaign — it will simply never end.",
  "@settingsLoopLimitNoneExplanation": {
    "description": "The line under the loop-ceiling control when None is chosen. 'While' is the name of a node and stays as it is in the app."
  },
  "panelCloseTab": "Close",
